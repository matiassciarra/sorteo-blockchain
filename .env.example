# Conexión PostgreSQL (Supabase / Neon / Local)
# Ejemplo Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Ejemplo Neon: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
# Sin DATABASE_URL la app guarda los datos en un archivo JSON temporal (modo local).
# Con DATABASE_URL usa PostgreSQL (necesario para publicarla en Vercel).
# DATABASE_URL="postgresql://usuario:password@host/neondb?sslmode=require"

